# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# Choose which provider to use: 'openrouter' or 'google-ai'
# If not specified, the system will auto-detect based on available API keys
LLM_PROVIDER=openrouter

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio API
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Admin
ADMIN_PASSCODE=change_me_in_production

# Model Configuration
MODEL_DEFAULT=anthropic/claude-3-haiku
TOKEN_BUDGET_PER_SESSION=20000

# Logging
LOG_LEVEL=info
